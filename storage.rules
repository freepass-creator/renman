rules_version = '2';
// Firebase Storage — 문서 원본(등록증·증권·계약·고지서). path = docs/{companyId}/…
// 권한 SSOT = Firebase Custom Claims(systemRole, companyId).
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() { return request.auth != null; }
    function isHQ() {
      return isSignedIn() && request.auth.token.systemRole == 'hq';
    }
    function myCompany() {
      return isSignedIn() && request.auth.token.systemRole == 'tenant'
        ? request.auth.token.companyId
        : null;
    }
    function tenantOK(companyId) {
      // Firestore 규칙과 동일 — companyId 가 문자열일 때만 소속 판정(claim 없는 계정 차단).
      return isHQ() || (isSignedIn() && companyId is string && myCompany() == companyId);
    }

    match /docs/{companyId}/{allPaths=**} {
      allow read: if isSignedIn() && tenantOK(companyId);
      // 원본 삭제는 본사만 — Firestore 와 같은 규칙(일반 삭제는 soft-delete, 하드삭제는 HQ).
      //   증빙 원본이 사라지면 감사 추적이 끊긴다. 교체는 같은 경로 덮어쓰기(update)로 된다.
      allow delete: if isHQ();
      allow create, update: if isSignedIn() && tenantOK(companyId)
        && request.resource.size > 0
        && request.resource.size <= 20 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)|application/pdf');
    }
  }
}
