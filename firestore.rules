rules_version = '2';
// jpkerp6 법인 격리 — companyId 기반. 진짜 보안 경계는 여기(서버).
// 권한 SSOT = Firebase Custom Claims:
//   { systemRole: 'hq' } 또는 { systemRole: 'tenant', companyId: string }
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isHQ() {
      return isSignedIn() && request.auth.token.systemRole == 'hq';
    }
    function myCompany() {
      return isSignedIn() && request.auth.token.systemRole == 'tenant'
        ? request.auth.token.companyId
        : null;
    }
    /**
     * ★companyId 가 «문자열일 때만» 소속 판정을 한다.
     *   빠뜨리면: 자가 가입(createUserWithEmailAndPassword)으로 만든 **claim 없는** 계정은
     *   myCompany() 가 null 이므로, companyId 가 없는 문서에 대해 null == null 로 통과한다.
     *   공개 API 키는 클라 번들에 박혀 있으므로 화면 없이도 계정을 만들 수 있다 —
     *   즉 businessColl 목록에 빠진 내부 컬렉션은 누구나 읽고 고칠 수 있었다.
     *   (2026-08-09 실측: 운영에 그런 문서 1건 `_conntest`. 나머지 31건은 명시 규칙이 막고 있었다.)
     *   businessColl 이 «제외 목록»이라 새 내부 컬렉션이 생길 때마다 같은 구멍이 다시 난다 →
     *   여기서 원천 차단한다.
     */
    function tenantOK(companyId) {
      return isHQ() || (isSignedIn() && companyId is string && myCompany() == companyId);
    }
    // ★ 민감 컬렉션 — 범용 규칙에서 반드시 제외. 각자의 명시 match만 지배(범용 OR 우회로 권한승격 차단).
    //   users: role 자기승격 방지 · period_locks: 마감 우회 방지 · audit_logs: 위변조 방지
    //   · company_master: 대외문서에 인쇄되는 법인 신원 위조 방지
    //   · company_registry: 서버 API에서만 관리하는 관리회사 범위.
    // 문서ID 소유권 — `{companyId}__…` 접두어. companyId 자체에 '__'가 없어야 유효(회사 id는 영숫자 slug).
    function docIdOwnedBy(docId, companyId) {
      return companyId is string
             && !companyId.matches('.*__.*')
             && docId.size() > companyId.size() + 2
             && docId[0:(companyId.size() + 2)] == companyId + '__';
    }
    function businessColl(coll) {
      return coll != 'users'
        && coll != 'company_master'
        && coll != 'company_registry'
        && coll != 'period_locks'
        && coll != 'audit_logs'
        && !coll.matches('migration.*')   // migration · migration_baselines · migration_acceptances
        && coll != '_api_rate_limits'
        && !coll.matches('_.*');   // 내부용(_conntest 등)은 업무 컬렉션이 아니다
    }

    // 서버 Admin 전용. 클라이언트는 조회·변조할 수 없다.
    match /_api_rate_limits/{id} {
      allow read, write: if false;
    }

    // 목록의 생성·이름변경·보관은 HQ 검증 API만 수행한다(Admin SDK).
    match /company_registry/{companyId} {
      allow read, write: if false;
    }

    // 마이그레이션 기준선·승인 — 서버 Admin 전용.
    //   승인은 «서버가 Firestore 실물을 세어 기준선과 대조했다»는 사실이다. 클라이언트가 쓸 수 있으면
    //   그 사실을 지어낼 수 있고(로컬 반영을 승인된 것으로 위장), 오픈 판단이 위조된 기록 위에 선다.
    //   읽기도 막는다 — 기대치·실제치가 곧 회사별 규모 정보다.
    //   ★막는 방법 = businessColl 에서 `migration*` 접두를 제외하는 것.
    //     규칙은 «허용»만 하고 거부하지 않으므로, 어느 match 도 열어 주지 않으면 그것이 차단이다.
    //     예전에 `match /migration/{docId} { allow read,write: if false }` 를 뒀는데
    //     ① 그 블록 자체는 아무것도 막지 못하고 ② 실제 컬렉션 이름은
    //     `migration_baselines`·`migration_acceptances` 라 businessColl 의 `!= 'migration'` 을
    //     빠져나가 범용 규칙에 그대로 노출돼 있었다(2026-08-09 실측 · 원본 덤프 2.7MB).
    //     이름이 바뀌어도 새지 않도록 접두로 맞춘다.

    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isHQ());
      allow create: if isHQ()
                    || (isSignedIn() && request.auth.uid == uid
                        && !('role' in request.resource.data)
                        && !('companyId' in request.resource.data));
      allow update, delete: if isHQ();
    }

    // 감사로그 — append-only. byUid = 로그인 uid 강제(위조 차단).
    match /audit_logs/{id} {
      allow read: if isSignedIn() && tenantOK(resource.data.companyId);
      allow create: if isSignedIn()
                    && tenantOK(request.resource.data.companyId)
                    && request.resource.data.companyId is string
                    && request.resource.data.byUid == request.auth.uid;
      allow update, delete: if false;
    }

    // 법인 마스터 — 대외문서(내용증명·과태료 공문·거래사실확인서)에 인쇄되는 법인 신원.
    //   ★쓰기 = 본사 또는 «자기 법인». 화면 권한(app/company/[id] allowed = isOperator || scope === id)과
    //     일치시킨다. 규칙만 본사로 좁히면 법인 사용자의 저장이 조용히 거부돼
    //     «저장됐다고 믿는데 로컬에만 남는» 상태가 된다(내가 고치려던 문제가 형태만 바꿔 재발).
    //   다른 회사 문서는 여전히 불가. companyId 필드도 문서 경로와 일치해야 한다.
    match /company_master/{companyId} {
      allow read: if isSignedIn() && tenantOK(companyId);
      allow write: if isSignedIn() && tenantOK(companyId)
                   && request.resource.data.companyId == companyId;
    }

    // 회계기간 마감 — 본사 쓰기, 소속 법인 읽기.
    match /period_locks/{companyId} {
      allow read: if isSignedIn() && tenantOK(companyId);
      allow write: if isHQ();
    }

    // ── 회계기간 마감(period_locks) 서버 강제 ─────────────────────────────
    // 왜 여기인가: 클라이언트 가드(lib/finance/period-lock.ts)는 localStorage를 보므로
    //   «설정 페이지를 한 번도 안 연 기기·새 브라우저»에서는 마감이 아예 없는 것으로 보인다.
    //   마감은 결산 무결성 장치라 «기기에 따라 달라지는 가드»는 가드가 아니다 → 경계에서 강제한다.
    // 본사도 막는다 — 마감월을 고치려면 «마감 해제» 또는 신규 분개(전기오류수정)를 타야 한다.
    function isMoneyColl(coll) { return coll == 'bank_tx' || coll == 'card_tx'; }
    function closedMap(companyId) {
      return exists(/databases/$(database)/documents/period_locks/$(companyId))
        ? get(/databases/$(database)/documents/period_locks/$(companyId)).data.get('map', {})
        : {};
    }
    function ymOf(data) {
      return data.get('txDate', '').size() >= 7 ? data.get('txDate', '')[0:7] : '';
    }
    function ymOpen(companyId, ym) { return ym == '' || !(ym in closedMap(companyId)); }
    // 수정: 원래 월도, 옮겨갈 월도 열려 있어야 한다(마감월 밖으로 빼내는 것도 차단).
    function moneyUpdatable(coll, companyId) {
      return !isMoneyColl(coll)
        || (ymOpen(companyId, ymOf(resource.data)) && ymOpen(companyId, ymOf(request.resource.data)));
    }
    function moneyDeletable(coll, companyId) {
      return !isMoneyColl(coll) || ymOpen(companyId, ymOf(resource.data));
    }

    // ── 자금 원자 불변(moneySourceImmutable) ──────────────────────────────
    // 왜: 서버 임포트 라우트는 create-only 로 «덮어쓰기»를 막았지만(P0-2), 클라이언트 SDK 의
    //   update 는 규칙이 지배한다. 막지 않으면 매칭 화면을 통해 들어온 update 하나로
    //   통장 거래의 금액·일자를 고쳐 결산을 사후에 바꿀 수 있다.
    // 무엇을: 은행·카드사가 만든 사실만. 앱이 붙이는 값(계정과목·매칭·정산·메모·수단)은 가변이다.
    //   ★목록은 lib/finance/immutable-money.ts MONEY_SOURCE_FIELDS 와 동일하게 유지할 것.
    //     (`memo` 는 일부러 제외 — 앱이 정산 라벨을 쓴다. 적요 원문 보존은 `jeokyo` 담당)
    // 누구까지: 본사도 막는다. 잘못 읽힌 거래는 원천 재수집, 취소·정정은 별도 거래가 정답이다.
    // 손입력 단건(txKey 없음)은 오타 정정을 허용한다 — 사람이 친 값이고 마감 가드는 그대로 걸린다.
    //   txKey 를 지운 뒤 고치는 2단계 우회는 불가(txKey 자체가 목록에 있다).
    function moneySourceImmutable(coll) {
      return !isMoneyColl(coll)
        || !('txKey' in resource.data)
        || !request.resource.data.diff(resource.data).affectedKeys().hasAny([
             'account', 'txDate', 'txTime', 'amount', 'withdraw', 'balance', 'counterparty', 'jeokyo',
             'approvalNo', 'cardNo', 'cardLast4', 'merchant',
             'txKey', '_key', 'raw'
           ]);
    }

    // 업무 데이터(vehicle·contract·payment·bank_tx…) — 법인 격리. businessColl()로 민감 컬렉션(users·period_locks·audit_logs)은 절대 여기 안 걸림 → 범용 OR 우회 차단.
    match /{coll}/{docId} {
      allow read: if isSignedIn() && businessColl(coll) && tenantOK(resource.data.companyId);
      // ★생성 시 문서ID 소유권도 강제 — docId = `{companyId}__{자연키}`(lib/store.ts firestoreDocId).
      //   없으면 남의 회사 문서ID를 «선점»해 그 회사의 정상 저장을 영구 차단할 수 있다(dedup read 거부→저장 실패).
      allow create: if isSignedIn() && businessColl(coll)
                    && tenantOK(request.resource.data.companyId)
                    && request.resource.data.companyId is string
                    && docIdOwnedBy(docId, request.resource.data.companyId);
      // 수정: 소유 법인이거나 본사. companyId(테넌트)는 불변 — 법인 사용자가 자기 문서를 남의 회사로 이동 금지(본사만 재배정 가능).
      allow update: if isSignedIn() && businessColl(coll)
                    && tenantOK(resource.data.companyId)
                    && (isHQ() || request.resource.data.companyId == resource.data.companyId)
                    && moneyUpdatable(coll, resource.data.companyId)
                    && moneySourceImmutable(coll);
      // 하드삭제=본사만. 일반 삭제는 soft-delete(deletedAt=update)로 → 휴지통·감사 보존.
      allow delete: if businessColl(coll) && isHQ() && moneyDeletable(coll, resource.data.companyId);
    }
  }
}
